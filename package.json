{
    "name": "color-index-app",
    "description": "Store color palettes and copy them to the clipboard in HEX or RGB list form, for creative coding.",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "jsdom": "^31.0.1",
        "prettier": "^3.10.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.74.0",
        "vite": "^8.3.8",
        "vitest": "^5.1.1"
    },
    "type": "module",
    "private": "true",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "lint": "eslint . && prettier --check .",
        "format": "prettier --write ."
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lvelazquez/color-index-app.git"
    },
    "engines": {
        "node": ">=20"
    },
    "version": "2.0.0"
}
